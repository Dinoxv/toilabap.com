{{!< default}}
<section class="pricing-hero">
  <div class="container">
    <div class="hero-badge"><span class="dot"></span> PRICING</div>
    <h1 class="section-title">Bang gia theo giai doan su dung.</h1>
    <p class="section-desc">Chon goi phu hop cho nhu cau cua ban: test, van hanh hay scale.</p>
  </div>
</section>

<section class="container pricing-grid">
  <article class="card pricing-card">
    <div class="feature-kicker">STARTER</div>
    <h3>$19 <span>/ thang</span></h3>
    <p>Cho ca nhan moi bat dau va muon xem nhanh cach site van hanh trong Ghost.</p>
    <ul>
      <li>1 landing page</li>
      <li>Basic CMS workflow</li>
      <li>Email support</li>
    </ul>
  </article>
  <article class="card pricing-card highlight">
    <div class="feature-kicker">PRO</div>
    <h3>$49 <span>/ thang</span></h3>
    <p>Phu hop cho van hanh site intro va pricing co cap nhat thuong xuyen.</p>
    <ul>
      <li>Landing + pricing</li>
      <li>Navigation config</li>
      <li>Priority support</li>
    </ul>
  </article>
  <article class="card pricing-card">
    <div class="feature-kicker">ELITE</div>
    <h3>$99 <span>/ thang</span></h3>
    <p>Danh cho team can quy trinh xuat ban, brand control va migration help.</p>
    <ul>
      <li>All Pro features</li>
      <li>Migrated content</li>
      <li>1:1 review</li>
    </ul>
  </article>
</section>

<section class="container page-note">
  <div class="content">{{content}}</div>
</section>
